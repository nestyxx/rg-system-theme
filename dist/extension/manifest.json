{
  "manifest_version": 3,
  "name": "RG System – thème Arobase",
  "version": "1.4.1",
  "description": "Habillage moderne (clair/sombre) de RG System Suite, côté navigateur uniquement. Aucune donnée collectée ni envoyée.",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://dashboard.rg-supervision.com/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Activer / désactiver le thème Arobase",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://dashboard.rg-supervision.com/*"],
      "css": ["fonts.css", "theme.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
